{include header.tpl}
<section class="card formcard"><div class="cardhead"><div><h2>New database table</h2><p>Define up to four initial columns; more can be added from SQL console.</p></div></div><form method="post" class="stack"><div class="formgrid"><label>Table name<input name="table_name" required pattern="[A-Za-z_][A-Za-z0-9_]*" placeholder="inventory"></label><label>Database type<select name="engine"><option value="sqlite" {if $engine == "sqlite"}selected{/if}>SQLite</option><option value="pgsql" {if $engine == "pgsql"}selected{/if}>PostgreSQL</option><option value="mysql" {if $engine == "mysql"}selected{/if}>MySQL</option></select></label></div><input type="hidden" name="column_count" value="4"><div class="tablewrap"><table class="editor"><thead><tr><th>Column name</th><th>Type</th><th>Not null</th><th>Default SQL</th><th>Primary key</th></tr></thead><tbody>
{for $i = 1; $i <= 4; $i++}<tr><td><input name="name_{$i}" {if $i == 1}required value="id"{/if} placeholder="column_name"></td><td><select name="type_{$i}"><option>INTEGER</option><option {if $i > 1}selected{/if}>TEXT</option><option>REAL</option><option>NUMERIC</option><option>BLOB</option><option>BOOLEAN</option><option>DATE</option><option>DATETIME</option><option>TIMESTAMP</option></select></td><td><input type="checkbox" name="notnull_{$i}" value="1"></td><td><input name="default_{$i}" placeholder="NULL or CURRENT_TIMESTAMP"></td><td><input type="checkbox" name="pk_{$i}" value="1" {if $i == 1}checked{/if}></td></tr>{/for}
</tbody></table></div><div class="formactions"><a href="/" class="button secondary">Cancel</a><button class="button">Create table</button></div></form></section>
{include footer.tpl}
