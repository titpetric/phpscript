{include header.tpl}
<div class="toolbar"><form method="get" class="search"><input name="q" value="{$search}" placeholder="Search all columns"><button>Search</button></form><div><a class="button secondary" href="/table/{$table}/structure" title="Structure" aria-label="Structure">&#9881;</a> <a class="button secondary" href="/table/{$table}/export" title="Export CSV" aria-label="Export CSV">&#8595;</a> <a class="button" href="/table/{$table}/insert" title="Insert row" aria-label="Insert row">+</a></div></div>
{if $without_rowid}<div class="notice warning">WITHOUT ROWID &middot; no row actions</div>{/if}
<section class="card"><div class="cardhead"><div><h2>{$table}</h2><p>{$total} matching rows · page {$page}</p></div></div><div class="tablewrap"><table><thead><tr>
{if !$without_rowid}<th>rowid</th>{/if}{foreach $columns as $column}<th>{$column.name}</th>{/foreach}<th>Actions</th></tr></thead><tbody>
{foreach $rows as $row}<tr>{if !$without_rowid}<td><code>{$row._rowid_}</code></td>{/if}{foreach $columns as $column}<td>{if $row[$column.name] === null}<span class="null">NULL</span>{else}{$row[$column.name]}{/if}</td>{/foreach}<td class="actions">{if !$without_rowid}<a href="/table/{$table}/row/{$row._rowid_}/edit" title="Edit row" aria-label="Edit row">&#9998;</a><form method="post" action="/table/{$table}/row/{$row._rowid_}/delete" onsubmit="return confirm('Delete row?')"><button class="link danger" title="Delete row" aria-label="Delete row">&times;</button></form>{/if}</td></tr>{else}<tr><td colspan="99" class="empty">No rows</td></tr>{/foreach}
</tbody></table></div></section><div class="pagination">{if $page > 1}<a href="?q={$search}&page={$page - 1}" title="Previous page" aria-label="Previous page">&larr;</a>{/if}<span>Page {$page}</span>{if $page * $limit < $total}<a href="?q={$search}&page={$page + 1}" title="Next page" aria-label="Next page">&rarr;</a>{/if}</div>
{include footer.tpl}
