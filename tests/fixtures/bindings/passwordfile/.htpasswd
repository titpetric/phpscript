# The file a fixture signs in against. Every line is one password,
# "hunter2hunter2", stored in a different format, so the fixture covers what
# htpasswd writes with each of its flags:
#
#   php -r 'echo password_hash("hunter2hunter2", PASSWORD_BCRYPT, ["cost" => 4]);'
#   openssl passwd -apr1 -salt Zx1kLm9q hunter2hunter2
#   php -r 'echo "{SHA}" . base64_encode(sha1("hunter2hunter2", true));'
#
# The bcrypt cost is 4, the lowest the algorithm accepts, because the fixture
# tests the dispatch and not the derivation. A deployment stores at a cost
# docs/reference/extensions/hashing.md prices.
admin:$2y$04$j1zOEFHUWgLb8D1SytMeoeFw/s1.z5eOLow3m0r25ypMopsjEbQGW
apache:$apr1$Zx1kLm9q$BwLItAYS8lPw/bCsIXHax1
legacy:{SHA}/IxesZSAbjGiE/BzEx5zsAEqD7U=
