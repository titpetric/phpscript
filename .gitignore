vendor
/phpscript
/docs/data
/docs/log
.venom*
*.pprof
*.db
*.sqlite
*.test
*.cov
/bin

# Coverage profiles, both Go and PHP, written here by the test job and by a
# server started with --cover. The directory is committed empty because the
# compose stack bind mounts it into the container.
/cover/*
!/cover/.gitkeep

# Build and run artifacts: the templates a demo compiles on first request, and
# venom's per-run logs. Neither is committed.
venom*.log
demos/*/templates/cache/

# The matrix runner writes a hidden temp script next to each fixture for the
# php runner, and the filesystem fixture writes into its own area folder.
tests/fixtures/**/.*.php
tests/fixtures/**/filesystem_fixture_*.txt
*.so

# Local agent/editor state, never committed.
/.claude

/LINT.md

# splint writes its document beside the tree it describes, and a job that
# fails leaves it behind.
splint.json

# Benchmark sweeps, compared with benchstat; never committed.
bench*.txt
bench*.json

# The documents `atkins gen` writes, which change on every run: the fixture
# matrix carries a duration per area and the coverage reports carry a percentage
# per package. Generating them inside the default pipeline dirtied the tree on
# every invocation, so they travel as release assets instead and
# `atkins release:docs` attaches them. The .md.tpl templates beside the coverage
# reports are the source and stay tracked, which *.md does not match.
/docs/test-fixtures.md
/docs/coverage/*.md
